<?xml version="1.0"?>
<!-- Einzelner NameNode ohne DataNodes für test.sh --docker. Er lauscht im
     Container auf 0.0.0.0 (bind-host), der Client auf dem Host spricht ihn
     über die veröffentlichten Ports auf localhost an. Andere Ports als der
     Testcluster (8020/9870), beide können gleichzeitig laufen. -->
<configuration>
  <property><name>dfs.namenode.name.dir</name><value>file:///tmp/hadoop-nn/name</value></property>
  <property><name>dfs.namenode.rpc-address</name><value>localhost:19000</value></property>
  <property><name>dfs.namenode.rpc-bind-host</name><value>0.0.0.0</value></property>
  <property><name>dfs.namenode.http-address</name><value>localhost:19870</value></property>
  <property><name>dfs.namenode.http-bind-host</name><value>0.0.0.0</value></property>
  <property><name>dfs.permissions.enabled</name><value>true</value></property>
</configuration>
